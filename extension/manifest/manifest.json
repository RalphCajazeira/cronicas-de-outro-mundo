{
  "manifest_version": 3,
  "name": "Crônicas de Outro Mundo",
  "description": "Shell visual local para Crônicas de Outro Mundo.",
  "version": "0.1.0",
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://cronicas-de-outro-mundo-staging-api.onrender.com/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Abrir Crônicas"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  }
}
