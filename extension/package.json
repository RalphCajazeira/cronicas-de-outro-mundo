{
  "name": "@cronicas/browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "validate:render-build": "node scripts/validate-render-build.mjs",
    "package:local": "npm run build && powershell -NoProfile -Command \"Compress-Archive -Path dist\\* -DestinationPath cronicas-extension-local.zip -Force\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.1.37",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jsdom": "27.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "cronicas-de-outro-mundo": "file:.."
  }
}
