{
  "name": "@cronicas/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:mcp": "vitest run --config vitest.config.ts src/modules/chatgpt-app/chatgpt-app.mcp.test.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "vitest --config vitest.config.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:clean-slate": "tsx scripts/clean-slate.ts",
    "staging:classify": "tsx scripts/classify-migrations.ts",
    "staging:db:preflight": "tsx scripts/staging-database.ts preflight",
    "staging:db:postflight": "tsx scripts/staging-database.ts postflight",
    "staging:deploy:trigger": "tsx scripts/staging-deploy.ts trigger",
    "staging:deploy:poll": "tsx scripts/staging-deploy.ts poll",
    "staging:smoke:mcp": "tsx scripts/smoke-staging-mcp.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jose": "6.2.4",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prisma": "7.8.0",
    "supertest": "7.2.2",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@prisma/dev@0.24.3": {
      "@hono/node-server": "1.19.13",
      "hono": "4.12.29"
    },
    "form-data": "4.0.6",
    "hono": "4.12.29"
  }
}
